       "COMM-SORTCODE": 987654,
       "COMM-NUMBER": 0
      },
      "COMM-ACC-TYPE": "SAVING",
      "COMM-INT-RT": 1.5,
      "COMM-OVERDR-LIM": 0,
      "COMM-AVAIL-BAL": 0,
      "COMM-ACT-BAL": 0
     },
     "env": {
      "CBSA_TASKN": "120"
     }
    },
    {
     "program": "INQACCCU",
     "commarea_in": {
      "CUSTOMER-NUMBER": 31
     },
     "env": {
      "CBSA_TASKN": "130"
     }
    },
    {
     "program": "INQCUST",
     "commarea_in": {
      "INQCUST-SCODE": "987654",
      "INQCUST-CUSTNO": 31
     },
     "env": {
      "CBSA_TASKN": "140"
     }
    }
   ]
  },
