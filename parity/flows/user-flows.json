{
 "description": "Multi-step user/API journeys replayed on both runtimes on one database per flow; each step gets its own EIBTASKN (env.CBSA_TASKN) on both sides.",
 "flows": [
  {
   "id": "user-flow/UF1-onboard-customer",
   "kind": "user-flow",
   "title": "React journey: create customer, open current + saving accounts, list accounts, view customer",
   "steps": [
    {
     "program": "CRECUST",
     "commarea_in": {
      "COMM-EYECATCHER": "CUST",
      "COMM-KEY": {
       "COMM-SORTCODE": 987654,
       "COMM-NUMBER": 0
      },
      "COMM-NAME": "Ms Parity O Onboard",
      "COMM-ADDRESS": "1 Parity Street, Leeds",
      "COMM-DATE-OF-BIRTH": 15061985
     },
     "env": {
      "CBSA_TASKN": "100"
     }
    },
    {
     "program": "CREACC",
     "commarea_in": {
      "COMM-EYECATCHER": "ACCT",
      "COMM-CUSTNO": 31,
      "COMM-KEY": {
       "COMM-SORTCODE": 987654,
       "COMM-NUMBER": 0
      },
      "COMM-ACC-TYPE": "CURRENT",
      "COMM-INT-RT": 0,
      "COMM-OVERDR-LIM": 500,
      "COMM-AVAIL-BAL": 0,
      "COMM-ACT-BAL": 0
     },
     "env": {
      "CBSA_TASKN": "110"
     }
    },
    {
     "program": "CREACC",
     "commarea_in": {
      "COMM-EYECATCHER": "ACCT",
      "COMM-CUSTNO": 31,
